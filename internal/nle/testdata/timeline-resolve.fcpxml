	<library>
		<event name="YT Cartell Studio">
			<project name="Тест · фільм">
				<sequence format="r1" duration="10s" tcStart="0s" tcFormat="NDF" audioLayout="stereo" audioRate="48k">
					<spine>
						<asset-clip ref="r5" offset="0s" name="Сцена 1 · Початок" start="1/2s" duration="4s" format="r1" tcFormat="NDF" audioRole="effects">
							<adjust-blend amount="1">
								<param name="amount">
									<keyframeAnimation>
										<keyframe time="1/2s" value="0" curve="linear"/>
										<keyframe time="19/24s" value="1" curve="linear"/>
									</keyframeAnimation>
								</param>
							</adjust-blend>
							<adjust-volume amount="-12dB">
								<param name="amount">
									<fadeIn type="easeIn" duration="7/24s"/>
								</param>
							</adjust-volume>
							<video ref="r10" lane="1" offset="4/3s" name="Сцена 1 · текст" start="0s" duration="5/2s"/>
							<asset-clip ref="r11" lane="-1" offset="3/2s" name="Сцена 1 · голос" start="0s" duration="2s" audioRole="dialogue"/>
							<asset-clip ref="r12" lane="-2" offset="1/2s" name="Музика" start="0s" duration="6s" audioRole="music">
								<adjust-volume amount="-14dB">
									<param name="amount">
										<keyframeAnimation>
											<keyframe time="0s" value="-14dB"/>
											<keyframe time="11/12s" value="-14dB"/>
											<keyframe time="1s" value="-26dB"/>
											<keyframe time="3s" value="-26dB"/>
											<keyframe time="83/24s" value="-14dB"/>
											<keyframe time="143/24s" value="-14dB"/>
										</keyframeAnimation>
									</param>
								</adjust-volume>
							</asset-clip>
							<marker start="1/2s" duration="1/24s" value="Сцена 1 · Початок"/>
						</asset-clip>
						<transition name="Cross Dissolve" offset="15/4s" duration="1/2s">
							<filter-video ref="r2" name="Cross Dissolve"/>
							<filter-audio ref="r3" name="Audio Crossfade"/>
						</transition>
						<asset-clip ref="r6" offset="4s" name="Сцена 2" start="1/4s" duration="9/4s" format="r1" tcFormat="NDF" audioRole="effects">
							<adjust-volume amount="-12dB"/>
							<asset-clip ref="r12" lane="-2" offset="9/4s" name="Музика" start="0s" duration="4s" audioRole="music">
								<adjust-volume amount="-14dB">
									<param name="amount">
										<keyframeAnimation>
											<keyframe time="0s" value="-14dB"/>
											<keyframe time="3/2s" value="-14dB"/>
											<keyframe time="95/24s" value="-96dB"/>
										</keyframeAnimation>
									</param>
								</adjust-volume>
							</asset-clip>
							<marker start="1/4s" duration="1/24s" value="Сцена 2"/>
						</asset-clip>
						<video ref="r7" offset="25/4s" name="Сцена 2 · утримання кадру" start="0s" duration="5/6s"/>
						<transition name="Fade To Color" offset="163/24s" duration="7/12s">
							<filter-video ref="r4" name="Fade To Color"/>
							<filter-audio ref="r3" name="Audio Crossfade"/>
						</transition>
						<video ref="r9" offset="85/12s" name="Сцена 3 · кадр" start="0s" duration="35/12s">
							<adjust-transform position="0 0" scale="1.12 1.12" rotation="0"/>
							<marker start="0s" duration="1/24s" value="Сцена 3"/>
						</video>
					</spine>
				</sequence>
			</project>
		</event>
